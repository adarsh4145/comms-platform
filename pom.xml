<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.adarsh4145</groupId>
  <artifactId>comms-platform</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Archetype - comms-platform</name>
  <url>http://maven.apache.org</url>
  <packaging>pom</packaging>
  <properties>

    <revision>0.0.1-SNAPSHOT</revision>
    <spring-boot.version>4.0.8</spring-boot.version>
    <core.version>0.0.1-SNAPSHOT</core.version>
    <java.version>25</java.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>4.0.8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>2025.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.github.adarsh4145</groupId>
        <artifactId>core</artifactId>
        <version>${core.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>core</module>
    <module>configServer</module>
    <module>cloudGateway</module>
    <module>eurekaServer</module>
    <module>dispatchService</module>
    <module>ingestionService</module>
    <module>providerService</module>
    <module>upstreamSimulator</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <!-- pinned: parent is not spring-boot-starter-parent, so an unpinned plugin resolves
             to whatever the LATEST release is - which was picking up a 4.2.0-M1 milestone -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.10.0</version>
          <configuration>
            <java>
              <!-- There used to be a bare <googleJavaFormat/> above this one. Two entries meant
                   the pinned version and style were not reliably the ones applied. -->
              <googleJavaFormat>
                <version>1.36.1</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- The compiler would fail on an older JDK anyway, but with "invalid target release: 25",
           which sends people hunting through the poms. Fail first, with the actual instruction. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>require-java-25</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${java.version},)</version>
                  <message>This project needs JDK ${java.version} or newer. Point JAVA_HOME (and IntelliJ's project SDK) at one.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <!-- Intentionally NOT bound to a lifecycle phase. Binding apply to process-sources made
             every build reformat files that had no code change in them, which buried real edits
             in unreviewable diffs. Run "mvn spotless:apply" by hand when you actually want it. -->
      </plugin>
    </plugins>

  </build>

</project>
