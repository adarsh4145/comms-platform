<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.adarsh4145</groupId>
  <artifactId>comms-platform</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Archetype - comms-platform</name>
  <url>http://maven.apache.org</url>
  <packaging>pom</packaging>
  <properties>

    <revision>0.0.1-SNAPSHOT</revision>
    <core.version>0.0.1-SNAPSHOT</core.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>4.1.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>2025.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.github.adarsh4145</groupId>
        <artifactId>core</artifactId>
        <version>${core.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>core</module>
    <module>configServer</module>
    <module>cloudGateway</module>
    <module>eurekaServer</module>
    <module>dispatchService</module>
    <module>ingestionService</module>
    <module>providerService</module>
    <module>upstreamSimulator</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>3.10.0</version> <!-- Use the latest version -->
          <configuration>
            <java>
              <!-- Use an external formatter file located at the project root -->
              <googleJavaFormat/>
              <googleJavaFormat>
                <version>1.36.1</version>
                <style>GOOGLE</style>
              </googleJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>

  </build>

</project>
